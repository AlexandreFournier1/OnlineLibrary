<!DOCTYPE html>
<html lang="en" class="htmlMainPage">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/main_style.css">
    <script src="/js/api_book_script.js" defer></script>
    <title>Search Page</title>
</head>
<body class="bodyMainPage">
    {% set showHomeLink = false %}
    {% set showLoginLink = showLoginLink or true %}
    {% set showPanierLink = showPanierLink or true %}

    {% include "partials/header.njk" %}

    <div class="title-Identifier">
        <h1>The Online Library</h1>
    </div>

    <div class="search-container">
        <input type="search" id="searchInput" placeholder="Enter a book title">
        <button id="search" title="Search"><img src="./img/search_black_24dp.png" alt="Search"></button>
        <button id="catalogue" title="Catalogue">
            <a href="/theme">
                <img src="./img/Pile_de_livres.png" >
            </a>
        </button>
    </div>

    <div class="books-container">
        <div class="book-box">
            <h2>Popular Books</h2>
            {% if popularBooks.length > 0 %}
                {% for book in popularBooks %}
                    <a class="book-item" href="/descriptionLivre/{{ book.id }}">
                        <img src="{{ book.couverture }}" alt="Couverture de {{ book.titre }}">
                        <div class="text-box">
                            <p id="title-book"><strong>{{ book.titre }}</strong></p>
                            <p><em>{{ book.auteur }}</em>, {{ book.annee }}</p>
                            <p>{{ book.description }}</p>
                        </div>
                    </a>
                {% endfor %}
            {% else %}
                <p>Aucun livre populaire disponible.</p>
            {% endif %}
        </div>

        <div class="book-box" id="latest-arrivals">
            <h2>Latest Arrivals</h2>
            {% if latestBooks.length > 0 %}
                {% for book in latestBooks %}
                    <a class="book-item" href="/descriptionLivre/{{ book.id }}">
                        <img src="{{ book.couverture }}" alt="Couverture de {{ book.titre }}">
                        <div class="text-box">
                            <p id="title-book"><strong>{{ book.titre }}</strong></p>
                            <p><em>{{ book.auteur }}</em>, {{ book.annee }}</p>
                            <p>{{ book.description }}</p>
                        </div>
                    </a>
                {% endfor %}
            {% else %}
                <p>Aucun livre récent disponible.</p>
            {% endif %}
        </div>
    </div>
</body>
</html>